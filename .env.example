# FinMind API (免費註冊: https://finmindtrade.com/)
FINMIND_TOKEN=your_finmind_token_here

# CONFIG 預設策略參數（修改後需重新啟動程式；個別策略 JSON 的 params 可覆寫）
# 基本面：EPS（元）、ROE（百分比，例如 15.0 代表 15%）
EPS_THRESHOLD=5.0
ROE_THRESHOLD=15.0
# 回測年數、持有交易日數（整數）
BACKTEST_YEARS=3
HOLD_DAYS=20
# 停利／停損（小數比例，例如 0.10 代表 10%）
TARGET_RETURN=0.10
STOP_LOSS=0.08
# 技術訊號門檻、BUY 總分門檻（整數，0–100）
MIN_TECH_SCORE_FOR_SIGNAL=60
MIN_TOTAL_SCORE_FOR_BUY=65
# 夜盤漲跌幅分類門檻（百分比，例如 1.5 代表 1.5%）
NIGHT_GAP_BIG=1.5
NIGHT_GAP_SMALL=0.5

# Telegram Bot (找 @BotFather 建立)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Sheet
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account JSON (整串壓成一行)
GOOGLE_CREDS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
